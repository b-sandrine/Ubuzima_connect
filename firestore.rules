rules_version = '2';

// Security rules for Ubuzima Connect. Deny-by-default: every request must
// be authenticated, and users may only write their own profile document.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // True when the document either has no owner yet (shared demo data) or is
    // owned by the requester.
    function ownsResource(resource) {
      return !('ownerId' in resource.data) ||
             resource.data.ownerId == request.auth.uid;
    }

    // AUTH — profile created on register / first sign-in.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['uid', 'email', 'role'])
        && request.resource.data.uid == userId;
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);
    }

    // PAT-03 — a patient's prescription schedule and its dose subcollection.
    match /prescriptions/{patientId} {
      allow read: if isSignedIn() && ownsResource(resource);
      allow write: if isSignedIn();

      match /doses/{doseId} {
        allow read, write: if isSignedIn();
      }
    }

    // DOC-06 — referrals, keyed by reference and tagged with a patientId.
    match /referrals/{reference} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['patientId', 'specialty',
             'status', 'direction']);
      allow update, delete: if isSignedIn();
    }

    // DOC-04 — a patient's medical-record timeline and its events.
    match /medical_records/{patientId} {
      allow read: if isSignedIn() && ownsResource(resource);
      allow write: if isSignedIn();

      match /events/{eventId} {
        allow read, write: if isSignedIn();
      }
    }

    // CHW health record + patient identity documents, with next steps.
    match /patients/{patientId} {
      allow read: if isSignedIn() && ownsResource(resource);
      allow write: if isSignedIn();

      match /next_steps/{stepId} {
        allow read, write: if isSignedIn();
      }
    }

    // Patient Home dashboard.
    match /patient_dashboard/{patientId} {
      allow read: if isSignedIn() && ownsResource(resource);
      allow write: if isSignedIn();
    }

    // Patient Medical Records screen + its loaded visits.
    match /patient_records/{patientId} {
      allow read: if isSignedIn() && ownsResource(resource);
      allow write: if isSignedIn();

      match /visits/{visitId} {
        allow read, write: if isSignedIn();
      }
    }

    // Patient AI Insights screen.
    match /ai_insights/{patientId} {
      allow read: if isSignedIn() && ownsResource(resource);
      allow write: if isSignedIn();
    }

    // Doctor/patient Alerts feed.
    match /notifications/{userId} {
      allow read: if isSignedIn() && ownsResource(resource);
      allow write: if isSignedIn();
    }

    // Doctor/patient Settings profile + emergency contacts.
    match /settings/{userId} {
      allow read: if isSignedIn() && ownsResource(resource);
      allow write: if isSignedIn();
    }

    // Everything not explicitly matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
